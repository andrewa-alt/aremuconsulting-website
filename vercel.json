{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/blog/:slug((?!\\.html$).*)",
      "destination": "/blog-:slug",
      "statusCode": 308
    },
    {
      "source": "/case-studies/:slug((?!\\.html$).*)",
      "destination": "/project-:slug",
      "statusCode": 308
    },
    {
      "source": "/lab/:path*",
      "destination": "/blog",
      "statusCode": 308
    },
    {
      "source": "/case-studies",
      "destination": "/projects",
      "statusCode": 308
    },
    {
      "source": "/lab",
      "destination": "/blog",
      "statusCode": 308
    },
    {
      "source": "/consultation",
      "destination": "/contact",
      "statusCode": 308
    }
  ]
}